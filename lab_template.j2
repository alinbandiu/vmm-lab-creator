
{# Defining vmm needs #}

#include "/vmm/bin/common.defs"
#define VMX_PHASE 3
#if VMX_PHASE == 3
#include "/vmm/data/vmm-configs/common/vmxc/common.vmx.p3.defs"
#elif VMX_PHASE == 2
#include "/vmm/data/vmm-configs/common/vmxc/common.vmx.p2.defs"
#else
#include "/vmm/data/vmm-configs/common/vmxc/common.vmx.p1.defs"
#endif
#include "/homes/abstine/vmx-nested-macros/common.vjunos.defs"
#include "/vmm/data/vmm-configs/common/vmxc/common.vptx.defs"
#include "/vmm/data/user_disks/vptxc/common.evovscapa.defs"
#define VMM_ENV_CSPP_CFG_DIR /vmm/data/user_disks/evo_test/EVOvSCAPA/
#define EVOVPTX_FPC_CSPP_IMG "/vmm/data/base_disks/junos/vevo/ubuntu_vm_evo.qcow2"
#undef vjunos_switch_disk
#undef vjunos_router_disk

{% for disk_name, disk_path in disks.items() %}
{% if disk_name.startswith('vqfx') %}
#define COSIM_DISK basedisk "/vmm/data/base_disks/default_images/default_image_vqfx10_mpc.img";
#define {{ disk_name }} basedisk "{{ disk_path }}";
{% elif disk_name.startswith('vmx') or disk_name.startswith('VROUTER') or disk_name.startswith ('VSWITCH') or disk_name.startswith ('vptx') %}
#define {{ disk_name }} basedisk "{{ disk_path }}";
{% elif disk_name.startswith('vscapa')%}
#define {{ disk_name }} "{{ disk_path }}"
{% else %}
#define {{ disk_name }} basedisk "{{ disk_path }}"
{% endif %}
{% endfor %}

##################################################################################

TOPOLOGY_START({{ lab_name }}) 

{# This loop dynamically creates one bridge for each link in the YAML file #}
{% for link in links %}
bridge "111__{{ loop.index }}aaeppss"{};
{% endfor %}


{# This loop iterates over each VM defined in the YAML file #}
{% for vm in vms %}

{# --- CASE 1: Handle 'vmx' type --- #}
{% if vm.type == 'vmx' %}
#undef  VMX_CHASSIS_I2CID
#undef  VMX_CHASSIS_NAME
#define VMX_CHASSIS_I2CID   21
#define VMX_CHASSIS_NAME    {{ vm.hostname }}
VMX_CHASSIS_START()
    VMX_RE_START({{ vm.hostname }}_RE, 0)
        VMX_RE_INSTANCE({{ vm.hostname }}_RE, {{ vm.disk }}, VMX_RE_I2CID, 0)
    VMX_RE_END
    VMX_MPC_START({{ vm.hostname }}_FPC1, 0)
        VMX_MPC_INSTANCE({{ vm.hostname }}_FPC1, {{ vm.disk }}, VMX_MPC_I2CID, 0)
        {% for iface in vm.interfaces %}
        VMX_CONNECT(GE({{ iface.fpc }},{{ iface.pic }},{{ iface.port }}), {{ iface.bridge }})
        {% endfor %}
    VMX_MPC_END
VMX_CHASSIS_END



{# --- CASE 2: Handle 'vptx' type --- #}
{% elif vm.type == 'vptx' %}
#undef VPTX_CHASSIS_I2CID
#define VPTX_CHASSIS_I2CID 85
#undef VPTX_CHASSIS_NAME
#define VPTX_CHASSIS_NAME {{ vm.hostname }}
#undef {{ vm.disk }}
{% for disk_name, disk_path in disks.items() %}
{% if disk_name.startswith('vptx') %}
#define {{ vm.disk }} basedisk "{{ disk_path }}";
{% endif %}
{% endfor %}
   VPTX_CHASSIS_START()
      VPTX_RE_START({{vm.hostname}}_RE, 0)
         VPTX_RE_INSTANCE({{vm.hostname}}_RE, {{vm.disk}}, VPTX_RE_I2CID, 0)
      VPTX_RE_END
      VPTX_MPC_START({{vm.hostname}}_FPC, 0)
          #undef VPTX_MPC_DISK
          #define VPTX_MPC_DISK VIRTUAL_MPC_DISK
         VPTX_MPC_INSTANCE({{vm.hostname}}_FPC, VPTX_MPC_DISK, VPTX_MPC_I2CID, 0)
          {% for iface in vm.interfaces %}
          VPTX_CONNECT(ET({{ iface.fpc }},{{ iface.pic }},{{ iface.port }},{{iface.subport}}),{{ iface.bridge }})
          {% endfor %}
      VPTX_MPC_END
   VPTX_CHASSIS_END




{# --- CASE 3: Handle 'vscapa' type --- #}
{% elif vm.type == 'vscapa' %}
#undef  PTX_CHAS_NAME
#define PTX_CHAS_NAME      {{ vm.hostname }}
#undef  PTX_CHAS_I2CID
#define PTX_CHAS_I2CID     240  /* JNX_PRODUCT_PTX10008 = 240 */
#define EVO_DEVELOPER_FILES \
        install "ENV(CONFIG_BASE)/evo-mount/yp.conf" "/etc/yp.conf";  \
        install "ENV(CONFIG_BASE)/evo-mount/auto.evo" "/etc/auto.evo"; \
        install "ENV(CONFIG_BASE)/evo-mount/auto.evofiler" "/etc/auto.evofiler"; \
        install "ENV(CONFIG_BASE)/evo-mount/auto.master" "/etc/auto.master";  \
        install "ENV(CONFIG_BASE)/evo-mount/nisdomainname" "/etc/nisdomainname";   \
        install "ENV(CONFIG_BASE)/evo-mount/nsswitch.conf" "/etc/nsswitch.conf";   \
        install "/vmm/data/vmm-configs/common/vptxc/rc.vmm" "/var/vmguest/rc.vmm";   \
        install "ENV(CONFIG_BASE)/evo-mount/ssh_host_rsa_key" "/home/root/.ssh/ssh_host_rsa_key"; \
        install "ENV(CONFIG_BASE)/evo-mount/ssh_host_rsa_key.pub" "/home/root/.ssh/ssh_host_rsa_key.pub";

EVOVPTX_CHASSIS_START_ (PTX_CHAS_NAME)
    EVOVPTX_RE_START_ (PTX_CHAS_NAME, EVOVPTX_RE0)
        #undef RE_BOOT_ARGS
        #define RE_BOOT_ARGS   " "
        #undef RE_I2CID
        #define RE_I2CID  0x0CA3
        EVOVPTX_RE0_INSTANCE_ISO_AUTODISK (PTX_CHAS_NAME, PTX_CHAS_I2CID, {{ vm.disk }}, EVOVPTX_RE0, RE_I2CID, RE_BOOT_ARGS)
        EVO_DEVELOPER_FILES
    EVOVPTX_RE_END_

    EVOVPTX_FPC_START_ (PTX_CHAS_NAME, EVOVPTX_FPC0)
        #undef FPC_BOOT_ARGS
        #define FPC_BOOT_ARGS   " "
        #undef FPC_I2CID
        #define FPC_I2CID  0x0D07
        EVOVPTX_FPC_INSTANCE_DISKLESS (PTX_CHAS_NAME, PTX_CHAS_I2CID, EVOVPTX_RE0, EVOVPTX_FPC0, FPC_I2CID, FPC_BOOT_ARGS)
    EVOVPTX_FPC_END_

    EVOVPTX_FPC_CSPP_START_ (PTX_CHAS_NAME, EVOVPTX_FPC0)
        EVOVPTX_FPC_CSPP_INSTANCE (PTX_CHAS_NAME, EVOVPTX_FPC0, EVOVPTX_FPC_CSPP_IMG)
        EVOVPTX_INSTALL_FPC_CSPP_BUNDLE_SCAPA (VMM_ENV_CSPP_CFG_DIR)
        {# This loop connects all the interfaces defined in the YAML file #}
        {% for iface in vm.interfaces %}
        EVOVPTX_CONNECT (IF_ET({{ iface.fpc }},{{ iface.pic }},{{ iface.port }}), {{ iface.bridge }})
        {% endfor %}
    EVOVPTX_FPC_CSPP_END_
EVOVPTX_CHASSIS_END_






{# --- CASE 4: Handle 'vrouter' type --- #}
{% elif vm.type == 'vrouter' %}
#undef VJUNOS_CHASSIS_NAME
#define VJUNOS_CHASSIS_NAME   {{ vm.hostname }}
   VJUNOS_CHASSIS_START()
      VJUNOS_START({{ vm.hostname }} , 0)
         VJUNOS_INSTANCE({{ vm.hostname }} , {{ vm.disk }}, VJUNOS_PRODUCT_VMX, 0)
         {% for iface in vm.interfaces %}
         VJUNOS_CONNECT(VJUNOS_GE({{ iface.fpc }},{{ iface.pic }},{{ iface.port }}), {{ iface.bridge }})
        {% endfor %}
     VJUNOS_END
   VJUNOS_CHASSIS_END



{# --- CASE 5: Handle 'vswitch' type --- #}
{% elif vm.type == 'vswitch' %}
#undef VJUNOS_CHASSIS_NAME
#define VJUNOS_CHASSIS_NAME   {{ vm.hostname }}
   VJUNOS_CHASSIS_START()
      VJUNOS_START({{ vm.hostname }} , 0)
         VJUNOS_INSTANCE({{ vm.hostname }} , {{ vm.disk }}, VJUNOS_PRODUCT_VEX, 0)
         {% for iface in vm.interfaces %}
         VJUNOS_CONNECT(VJUNOS_GE({{ iface.fpc }},{{ iface.pic }},{{ iface.port }}), {{ iface.bridge }})
        {% endfor %}
     VJUNOS_END
   VJUNOS_CHASSIS_END




{# --- CASE 6: Handle 'server' type --- #}
{% elif vm.type == 'server' %}
vm "{{ vm.hostname }}" {
    hostname "{{ vm.hostname }}";
    {% if vm.disk is defined %}
    {{ vm.disk }};
    {% endif %}
    ncpus {{ vm.ncpus }};
    memory {{ vm.memory }};
    
    {# Servers get a dedicated management interface on em0 #}
    interface "em0" { bridge "external"; };
    {# This loop adds data interfaces (em1, em2, etc.) based on the 'links' data #}
    {% for iface in vm.interfaces %}
    interface "{{ iface.name }}" { bridge "{{ iface.bridge }}"; };
    {% endfor %}
};



{# --- CASE 7: Handle 'vqfx' type --- #}
{% elif vm.type == 'vqfx' %}
vm "{{ vm.hostname }}" {
    hostname "{{ vm.hostname }}";
    {% if vm.disk is defined %}
    {{ vm.disk }}
    {% endif %}
    setvar "boot_noveriexec" "YES";
    setvar "qemu_args" "-smbios type=1,product=QFX10K-11";
    install "/vmm/bin/configs/quincy/junos/vqfx.base.systest.conf" "/root/junos.base.conf";
    interface "em0" { EXTERNAL; };
    interface "em1" { bridge "pecosim_bridge_{{ vm.hostname }}"; ipaddr "169.254.0.2"; };
    interface "em2" { bridge "reserved_bridge"; };
    {% for iface in vm.interfaces %}
    interface "{{ iface.mapped_name }}" { bridge "{{ iface.bridge }}"; };
    {% endfor %}
};
vm "pecosim{{ vm.hostname }}_FPC" {
    hostname "pecosim{{ vm.hostname}}_FPC";
    COSIM_DISK
    memory 4096;
    ncpus 2;
    interface "em0" { EXTERNAL; };
    interface "em1" { bridge "pecosim_bridge_{{ vm.hostname }}"; ipaddr "169.254.0.1"; };
};



{#  Handle bridges --- #}
bridge "pecosim_bridge_{{ vm.hostname }}"{};
{% endif %}


{% endfor %}
{% if 'vqfx' in types %}
bridge "reserved_bridge"{};
{% endif %}



PRIVATE_BRIDGES
TOPOLOGY_END
