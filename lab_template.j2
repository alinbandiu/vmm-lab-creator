{# Emitted here, ONCE per lab, and deliberately NOT inside the per-vm loop.
   vmm folds every '#define VMM_ENV_*' line in the file into a single process
   environment variable that ENV() reads at bind time, so a second #define
   appends rather than overwrites - even when both copies carry the same path.
   See the CASE 3b comment on the vbrackla block for the full failure mode. #}
#define VMM_ENV_CSPP_CFG_DIR   /vmm/data/vmm-configs/common/vptxc/cspp_cfg/EVOvBRACKLA/COSIMPP
{% endif %}
