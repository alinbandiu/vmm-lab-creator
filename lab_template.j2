TOPOLOGY_START({{ lab_name }})

{# One bridge per link in the YAML file. #}
{% for link in links %}
bridge "111__{{ loop.index }}aaeppss"{};
{% endfor %}


{# VMs are emitted in vmm3 family order (RAW -> PREFIXED -> vbowmore last),
   pre-sorted in generate_config (VMM3_EMIT_RANK). Ports connect to the normal
   per-link bridge, not the literal 'privateN' bridges from the reference. #}
{% for vm in vms %}

{# --- CASE 1: 'vmx' (multi-FPC) --- #}
{% if vm.type == 'vmx' %}
#undef  VMX_CHASSIS_I2CID
#undef  VMX_CHASSIS_NAME
#define VMX_CHASSIS_I2CID   21
#define VMX_CHASSIS_NAME    {{ vm.hostname }}
VMX_CHASSIS_START()
    VMX_RE_START({{ vm.hostname }}_RE, 0)
        VMX_RE_INSTANCE({{ vm.hostname }}_RE, {{ vm.disk }}, VMX_RE_I2CID, 0)
        VMX_SYSTEST_CONFIG_ENHIP
    VMX_RE_END
    {% for group in vm.fpc_groups %}
    VMX_MPC_START({{ vm.hostname }}_FPC{{ group.fpc }}, {{ group.fpc }})
        #undef VMX_MPC_DISK
        #define VMX_MPC_DISK VIRTUAL_MPC_DISK
        VMX_MPC_INSTANCE({{ vm.hostname }}_FPC{{ group.fpc }}, VMX_MPC_DISK, {{ group.i2cid_macro }}, {{ group.fpc }})
        {% for iface in group.interfaces %}
        {% if iface.macro == 'GE' %}
        VMX_CONNECT(GE({{ iface.fpc }},{{ iface.pic }},{{ iface.port }}), {{ iface.bridge }})   // {{ iface.name }}
        {% elif iface.macro == 'XE' %}
        VMX_CONNECT(XE({{ iface.fpc }},{{ iface.pic }},{{ iface.port }}), {{ iface.bridge }})   // {{ iface.name }}
        {% elif iface.macro == 'XE_CHAN' %}
        VMX_CONNECT(XE_CHAN({{ iface.fpc }},{{ iface.pic }},{{ iface.port }},{{ iface.subport }}), {{ iface.bridge }})   // {{ iface.name }}
        {% endif %}
        {% endfor %}
    VMX_MPC_END
    {% endfor %}
VMX_CHASSIS_END



{# --- CASE 1b: 'vferrari' (single FPC0, 5 x 100G ports) --- #}
{% elif vm.type == 'vferrari' %}
#undef  VMX_CHASSIS_I2CID
#define VMX_CHASSIS_I2CID   33
#undef  VMX_MPC_MEMORY
#define VMX_MPC_MEMORY      8192
#undef  VMX_CHASSIS_NAME
#define VMX_CHASSIS_NAME    {{ vm.hostname }}
#undef  VMX_MPC_DISK
#define VMX_MPC_DISK        VMPC_LTS22_IMAGE
VMX_CHASSIS_START()
    VMX_RE_START({{ vm.hostname }}_RE, 0)
        VMX_RE_INSTANCE({{ vm.hostname }}_RE, {{ vm.disk }}, VMX_RE_I2CID, 0)
        {# The ZT MPC (VMX_ZT_MPC_I2CID 0xCD8) is only supported in
           'network-services enhanced-ip'. Without this the RE boots in the
           default 'ip' mode and chassisd marks FPC0
           'Offline ---FPC misconfiguration---'.
           The Phase 4 baseline also sets enhanced-ip, but a network-services
           change does not take effect until the chassis resets, so applying it
           post-boot leaves FPC0 down until the device is rebooted by hand.
           This installs the enhanced-ip base config so the RE comes up in the
           right mode to begin with - same hook the 'vmx' case above uses. #}
        VMX_SYSTEST_CONFIG_ENHIP
    VMX_RE_END

    VMX_MPC_START({{ vm.hostname }}_FPC0, 0)
        #undef VMX_MPC_MEMORY
        #define VMX_MPC_MEMORY 8192
        VMX_MPC_INSTANCE({{ vm.hostname }}_FPC0, VMX_MPC_DISK, VMX_ZT_MPC_I2CID, 0)
        {% for iface in vm.interfaces %}
        VMX_CONNECT(ET({{ iface.fpc }}, {{ iface.pic }}, {{ iface.port }}, {{ iface.subport }}), {{ iface.bridge }})   // {{ iface.name }}
        {% endfor %}
    VMX_MPC_END
VMX_CHASSIS_END



{# --- CASE 1d: 'vbugatti' (vMX304 + LC304 linecard) [vmm3] ---
   RE console '{hostname}-re0'. Chassis I2C id from vm.chassis_i2cid (base 22,
   so it coexists with valfaromeo=21). #}
{% elif vm.type == 'vbugatti' %}
#undef  VMX304_CHASSIS_I2CID
#undef  VMX304_CHASSIS_NAME
#define VMX304_CHASSIS_I2CID {{ vm.chassis_i2cid }}
#define VMX304_CHASSIS_NAME  {{ vm.hostname }}
#undef  FPC_BOOT_ARGS
#define FPC_BOOT_ARGS " "
VMX304_CHASSIS_START()
VMX304_RE_START({{ vm.hostname }}-re0, 0)
    setvar "qemu_args" "-smbios type=1,product=PviModel,manufacturer=JUNIPER";
    VMX304_RE_INSTANCE({{ vm.hostname }}-re0, {{ vm.disk }}, VMX_RE_I2CID, 0)
    setvar "metadata_disk_size" "4096M";
    setvar "vm_retype" "RE-TVP";
    setvar "hgcomm_vector_idx" "6";
    install "/vmm/data/user_disks/vbugatti/config_files/mx304-meta-data-disk.img" "/tvp_platform_config.tgz";
    install "/vmm/data/user_disks/vbugatti/config_files/system.config" "/root/olive.conf";
    install "/vmm/data/user_disks/vbugatti/config_files/inetd.conf" "/etc/inetd.conf";
    install "/vmm/data/user_disks/vbugatti/config_files/jlaunchd.conf" "/etc/jlaunchd.conf";
    install "/vmm/data/user_disks/vbugatti/config_files/pxe_slot_attrib.conf" "/usr/share/pfe/pxe_slot_attrib.conf";
VMX304_RE_END
LC304_FPC_START_(VMX304_CHASSIS_NAME, LC304_FPC0)
    setvar "qemu_args" "-drive file=/vmm/data/user_disks/vredbull/boot/vREDBULL_OVMF_CODE.fd,if=pflash,format=raw,unit=0,readonly=on -drive file=/vmm/data/user_disks/vredbull/boot/vREDBULL_OVMF_VARS.fd,if=pflash,format=raw,unit=1,readonly=on";
    LC304_FPC_INSTANCE_DISKLESS(VMX304_CHASSIS_NAME, VMX304_CHASSIS_I2CID, LC304_RE0, LC304_FPC0, VMX304_MPC_I2CID, FPC_BOOT_ARGS)
    {% for iface in vm.interfaces %}
    LC304_CONNECT(LC304_IF_ET_100G({{ iface.fpc }}, {{ iface.pic }}, {{ iface.port }}), {{ iface.bridge }})   // {{ iface.name }}
    {% endfor %}
LC304_FPC_END_
VMX304_CHASSIS_END



{# --- CASE 1e: 'vhamilton' (vMX10004, up to 3 linecards) [old-pod, kept] --- #}
{% elif vm.type == 'vhamilton' %}
{% for iface in vm.interfaces %}
#undef IF_ET_X_{{ iface.pic }}_{{ iface.port }}
{% endfor %}
#undef  VMX10004_CHASSIS_NAME
#define VMX10004_CHASSIS_NAME {{ vm.hostname }}
VMX10004_CHASSIS_START()
    VMX10004_RE_START({{ vm.hostname }}_RE, 0)
        VMX10004_RE_INSTANCE({{ vm.hostname }}, {{ vm.disk }}, VMX10004_RE_I2CID, 0)
        setvar "smbios.system.maker" "JUNIPER";
        setvar "smbios.system.product" "RE-PTX-2X00x8";
        setvar "vm_retype" "RE-TVP";
        setvar "hgcomm_vector_idx" "7";
        install "/vmm/data/user_disks/mx-10k-m/mx10004/default_tvp_platform_config_mx_tgz.img" "/tvp_platform_config.tgz";
        install "/vmm/data/user_disks/mx-10k-m/mx10004/system.config" "/root/olive.conf";
        install "/vmm/data/user_disks/mx-10k-m/common/services" "/etc/services";
        install "/vmm/data/user_disks/mx-10k-m/common/inetd.conf" "/etc/inetd.conf";
        install "/vmm/data/user_disks/mx-10k-m/common/jlaunchd.conf" "/etc/jlaunchd.conf";
        install "/vmm/data/user_disks/mx-10k-m/mx10004/pxe_slot_attrib.conf" "/usr/share/pfe/pxe_slot_attrib.conf";
    VMX10004_RE_END
#undef  FPC_BOOT_ARGS
#define FPC_BOOT_ARGS " "
#undef  VHAMILTON_I2CID
#define VHAMILTON_I2CID 0x0DD5
#undef  VMX10004_FPC_CHASSIS_MODEL
#define VMX10004_FPC_CHASSIS_MODEL 273
    {% for fpc_num, fpc_ifaces in vm.interfaces | groupby('fpc') %}
    VHAMILTON_FPC_START_(VMX10004_CHASSIS_NAME, VHAMILTON_FPC{{ fpc_num }})
        setvar "qemu_args" "-drive file=/vmm/data/user_disks/mx-10k-m/vulc/vULC_OVMF_CODE.fd,if=pflash,format=raw,unit=0,readonly=on -drive file=/vmm/data/user_disks/mx-10k-m/vulc/vULC_OVMF_VARS.fd,if=pflash,format=raw,unit=1,readonly=on";
        VHAMILTON_FPC_INSTANCE_DISKLESS(VMX10004_CHASSIS_NAME, VMX10004_FPC_CHASSIS_MODEL, VHAMILTON_RE0, VHAMILTON_FPC{{ fpc_num }}, VHAMILTON_I2CID, FPC_BOOT_ARGS)
        {% for iface in fpc_ifaces %}
        VHAMILTON_CONNECT(IF_ET({{ iface.fpc }}, {{ iface.pic }}, {{ iface.port }}), {{ iface.bridge }})   // {{ iface.name }}
        {% endfor %}
    VHAMILTON_FPC_END_
    {% endfor %}
VMX10004_CHASSIS_END



