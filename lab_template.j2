    EVOvArdbegRE(PTX_CHAS_NAME, {{ vm.disk }})
    EVOvArdbeg_CSPP_INSTANCE_START(PTX_CHAS_NAME, QS_CSPP_IMG)
        {% for iface in vm.interfaces %}
        EVOVPTX_CONNECT(IF_ET({{ iface.fpc }}, {{ iface.pic }}, {{ iface.port }}), {{ iface.bridge }})   // {{ iface.name }}
        {% endfor %}
    EVOvArdbeg_CSPP_END
EVOVPTX_CHASSIS_END_



{# --- CASE 3b: 'vbrackla' [vmm3, EVOvBracklaRE + EVOvBrackla_CSPP_START, RAW] ---
   RE console '{hostname}_RE0'.

   VMM_ENV_CSPP_CFG_DIR must be defined EXACTLY ONCE per generated .conf.
   It is not a plain cpp macro: vmm harvests every '#define VMM_ENV_*' line out
   of the whole file into a single process environment variable that ENV() reads
   at bind time. '#undef' does not remove a previous value - a second #define
   makes the variable hold BOTH paths joined by a newline, so vendor's
   CSPPinstall (common.brackla.defs:85, which hardcodes
   ENV(VMM_ENV_CSPP_CFG_DIR)) resolves to
   '<first-dir>\n<second-dir>/vbrackla_cspp.conf' - a file that does not exist.
   vmm bind then fails with (-1), the CSPP vm stays Unbound, and the RE shows
   FPC1 stuck in 'Onlining' forever because its PFE never boots.

   Two ways this duplicated before the fix, and BOTH are now closed:
     1. the define lived in the per-vm loop, so N vbrackla devices emitted N
        copies - identical text still concatenates into '<dir>\n<dir>';
     2. vbowmore redefined the same name for its own bundle dir.
   The define is therefore emitted once in the header under
   {% raw %}{% if 'vbrackla' in types %}{% endraw %}, and every other CSPP type takes its
   bundle dir as a macro PARAMETER instead
   (e.g. EVOVPTX_INSTALL_FPC_CSPP_BUNDLE_BOWMORE(QS_CSPP_DIR_VBOWMORE)), so
   vbrackla stays the only consumer of this env var. #}
{% elif vm.type == 'vbrackla' %}
#undef  PTX_CHAS_NAME
#define PTX_CHAS_NAME {{ vm.hostname }}
EVOVPTX_CHASSIS_START_(PTX_CHAS_NAME)
    EVOvBracklaRE(PTX_CHAS_NAME, {{ vm.disk }})
    EVOvBrackla_CSPP_START(PTX_CHAS_NAME, QS_CSPP_IMG)
        {% for iface in vm.interfaces %}
        EVOVPTX_CONNECT(IF_ET({{ iface.fpc }}, {{ iface.pic }}, {{ iface.port }}), {{ iface.bridge }})   // {{ iface.name }}
        {% endfor %}
    EVOvBrackla_CSPP_END
EVOVPTX_CHASSIS_END_



{# ===================== vmm3 PREFIXED consumers (rank 2) =====================
   Each PREFIXED block #undef-s only the IF_ET_X aliases it uses, so its
   token-pasting *_CONNECT expands the raw form (not the alias -> not junk like
   'VBALERION_eth13').

   The #undef MUST be keyed by PIC, not FPC. Verified on the pod:
       #define IF_ET(FPC, PIC, PORT)       CATENATE(IF_ET_X_, CATENATE3(PIC, _, PORT))
       #define IF_ET_CHAN(FPC,PIC,PORT,CH) CATENATE(IF_ET_X_, CATENATE5(PIC, _, PORT, _, CH))
   FPC is discarded by both macros - IF_ET(1,0,0) and IF_ET(0,0,0) are both eth4,
   while IF_ET(0,1,0) is eth16. Using iface.fpc here silently undef-s the wrong
   symbol on any multi-linecard device (valfaromeo allows 3 FPCs), leaving the
   real alias live so *_CONNECT emits 'VALFAROMEO_eth4'. VMM accepts that name
   without complaint and the link is created but never bound -> silent dead link,
   the same failure class as wiring a port outside the CSPP range. #}

{# --- CASE 3c: 'vbalerion' [vmm3, VBALERION_CONNECT] --- #}
{% elif vm.type == 'vbalerion' %}
{% for iface in vm.interfaces %}
#undef IF_ET_X_{{ iface.pic }}_{{ iface.port }}
{% endfor %}
#undef  PTX_CHAS_NAME
#define PTX_CHAS_NAME {{ vm.hostname }}
#undef  EVOvBalerion_RE_MEMORY
#define EVOvBalerion_RE_MEMORY 16384
    EVOvBalerionRE(PTX_CHAS_NAME, {{ vm.disk }})
    EVOvBalerion_CSPP_INSTANCE_START(PTX_CHAS_NAME, QS_CSPP_IMG)
        {% for iface in vm.interfaces %}
        VBALERION_CONNECT(IF_ET({{ iface.fpc }}, {{ iface.pic }}, {{ iface.port }}), {{ iface.bridge }})   // {{ iface.name }}
        {% endfor %}
    EVOvBalerion_CSPP_END



