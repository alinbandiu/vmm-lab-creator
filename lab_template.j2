{# vHamilton and vMaserati are vMX10004 linecards sharing the pre-vmm3 chassis
   header. Both use PREFIXED connectors (VHAMILTON_/VMASERATI_CONNECT), so they
   are rank 2 in VMM3_EMIT_RANK and each #undef-s the IF_ET_X aliases it uses -
   that is what lets them share a file with the vmm3 EVO types.
   NOTE: common.vmaserati.defs line 1 unconditionally pulls in
   common.evovptx.utils.defs, whose EVOVPTX_CHASSIS_START_ differs from the one
   in common.evovptx.defs below. cpp warns on that redefinition and VMM treats
   any cpp warning as fatal, so the shared macro is #undef-ed before the EVO
   include further down. Everything else the two headers share (IF_ET,
   EVOVPTX_CONNECT, the MAC_LSB_* table) is byte-identical and warns silently. #}
{% if 'vhamilton' in types or 'vmaserati' in types %}
#include "/vmm/data/user_disks/mx-10k-m/mx10004/common.vmx10004.defs"
{% endif %}
{% if 'vhamilton' in types %}
#include "/vmm/data/user_disks/vhamilton/common.vhamilton.defs"
{% endif %}
{% if 'vmaserati' in types %}
#include "/vmm/data/user_disks/vmaserati/common.vmaserati.defs"
{% endif %}

{# =====================================================================
   vmm3 EVO / cosim family - LOAD-BEARING include order.
   common.evovptx.iface.et.defs (pulled in by common.evovptx.defs) installs ~250
   UNPREFIXED IF_ET_X_* aliases. RAW connectors (EVOVPTX_CONNECT, LC304_CONNECT)
   need them ALIVE; PREFIXED connectors (VBALERION_/VALFAROMEO_/
   VBOWMORE_CONNECT) token-paste and need them DEAD. The single base
   common.evovptx.defs is included first (NOT common.evovptx.utils.defs, which
   redefines EVOVPTX_CHASSIS_START_ and would abort with a fatal warning). ardbeg
   replaces the shared chassis macro, so it is #undef-ed before that include.
   ===================================================================== #}
{% if 'vscapa' in types or 'vardbeg' in types or 'vbrackla' in types or 'vbalerion' in types or 'vbowmore' in types or 'valfaromeo' in types or 'vbugatti' in types %}
{# Dropped so common.evovptx.defs can install its own without a fatal cpp
   warning when common.vmaserati.defs has already pulled in the utils variant.
   '#undef' of an undefined macro is legal and silent, so this is unconditional. #}
#undef EVOVPTX_CHASSIS_START_
#include "/vmm/data/vmm-configs/common/vptxc/common.evovptx.defs"
{% endif %}
{% if 'vbrackla' in types %}
#include "/vmm/data/vmm-configs/common/vptxc/common.brackla.defs"
{% endif %}
{% if 'vbalerion' in types %}
#include "/vmm/data/vmm-configs/common/vptxc/common.balerion.defs"
{% endif %}
{% if 'vscapa' in types %}
#include "/vmm/data/vmm-configs/common/vptxc/common.evovscapa.compat.defs"
{% endif %}
{% if 'vardbeg' in types %}
#undef EVOVPTX_CHASSIS_START_
#include "/vmm/data/vmm-configs/common/vptxc/common.evovptx.ardbeg.defs"
#include "/vmm/data/vmm-configs/common/vptxc/common.ardbeg.defs"
{% endif %}
{% if 'vbugatti' in types %}
#include "/vmm/data/vmm-configs/common/vbugatti/headers/common.vmx304.defs"
#include "/vmm/data/vmm-configs/common/vbugatti/headers/common.lc304.defs"
{% endif %}
{% if 'valfaromeo' in types %}
