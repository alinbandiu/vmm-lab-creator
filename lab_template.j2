
{# Defining vmm needs #}

#include "/vmm/bin/common.defs"
{# vAlfaRomeo runs on the MX10008 chassis macros plus its own FPC macros.
   These are included ahead of the VMX_PHASE block to match the ordering of
   the known-good hand-written config, and only when the topology actually
   uses the type, so the headers can't collide with the other profiles. #}
#define VMX_PHASE 3
#if VMX_PHASE == 3
#include "/vmm/data/vmm-configs/common/vmxc/common.vmx.p3.defs"
#elif VMX_PHASE == 2
#include "/vmm/data/vmm-configs/common/vmxc/common.vmx.p2.defs"
#else
#include "/vmm/data/vmm-configs/common/vmxc/common.vmx.p1.defs"
#endif
{# These are gated on the types that actually need them. common.vptx.defs in
   particular defines the channelized-et helpers (IF_ET_CHAN etc.); when it is
   included AFTER common.valfaromeo.defs it overrides vAlfaRomeo's versions,
   which makes VALFAROMEO_CONNECT emit an invalid interface name
   ('VALFAROMEO_eth4') and 'vmm config' fail. The known-good hand-written
   vAlfaRomeo config includes neither of these headers. #}
{% if 'vrouter' in types or 'vswitch' in types %}
#include "/homes/abstine/vmx-nested-macros/common.vjunos.defs"
{% endif %}
{% if 'vptx' in types or 'vscapa' in types or 'vbrackla' in types %}
#include "/vmm/data/vmm-configs/common/vmxc/common.vptx.defs"
{% endif %}
{# vAlfaRomeo ships its OWN common.vptx.defs. It defines the VPTX_* chassis
   macros and IF_ET_CHAN differently from the standard one, so the two can
   never appear in the same file - hence valfaromeo is rejected alongside
   vptx/vscapa/vbrackla in validate_topology(). Including the standard one
   instead is what produced the invalid 'VALFAROMEO_eth4' interface. #}
{% if 'valfaromeo' in types %}
#include "/vmm/data/user_disks/dhahm/valfaromeo/common.vptx.defs"
#include "/vmm/data/user_disks/dhahm/valfaromeo/common.valfaromeo.defs"
{% endif %}
{# vFerrari reuses the standard VMX chassis/MPC macros; it only needs its own
   MPC I2C id. #}
{% if 'vferrari' in types %}
#define VMX_ZT_MPC_I2CID   0xCD8
{% endif %}
{# NOTE: common.evovscapa.defs and common.evovptx.defs (which common.brackla.defs
   depends on) both #define the same macro names with different values for
   their respective hardware profiles (EVOVPTX_MPC_MEMORY, EVOVPTX_RE_NCPU,
   EVOVPTX_FPC_CSPP_INSTANCE, BASECONFIG, etc.). Including both in one file
   makes 'vmm config' fail its preprocessing step. 'vscapa' and 'vbrackla'
   can therefore not currently be used together in the same topology/lab -
   only include whichever one this topology actually uses. #}
{% if 'vscapa' in types %}
#include "/vmm/data/user_disks/vptxc/common.evovscapa.defs"
{% endif %}
{% if 'vbrackla' in types %}
#include "/vmm/data/user_disks/vptxc/common.brackla.defs"
#include "/vmm/data/user_disks/vptxc/common.evovptx.defs"
{% endif %}
{# vscapa and vbrackla are mutually exclusive (enforced in validate_topology()),
   so VMM_ENV_CSPP_CFG_DIR only ever needs one value per generated file - no
   need to redefine it per-VM. Redefining it repeatedly via #undef/#define
   was found to break 'vmm config''s preprocessing, so this is set once. #}
{% if 'vscapa' in types %}
#define VMM_ENV_CSPP_CFG_DIR /vmm/data/user_disks/evo_test/EVOvSCAPA/
{% elif 'vbrackla' in types %}
#define VMM_ENV_CSPP_CFG_DIR /vmm/data/user_disks/evo_test/EVOvBRACKLA/COSIMPP/
{% endif %}
#define EVOVPTX_FPC_CSPP_IMG "/vmm/data/base_disks/junos/vevo/ubuntu_vm_evo.qcow2"
#undef vjunos_switch_disk
#undef vjunos_router_disk

{% for disk_name, disk_path in disks.items() %}
{% if disk_name.startswith('vqfx') %}
#define COSIM_DISK basedisk "/vmm/data/base_disks/default_images/default_image_vqfx10_mpc.img";
#define {{ disk_name }} basedisk "{{ disk_path }}";
{% elif disk_name.startswith('vmx') or disk_name.startswith('VROUTER') or disk_name.startswith ('VSWITCH') or disk_name.startswith ('vptx') or disk_name.startswith('vferrari') or disk_name.startswith('valfaromeo') %}
#define {{ disk_name }} basedisk "{{ disk_path }}";
{% elif disk_name.startswith('vscapa') or disk_name.startswith('vbrackla') %}
#define {{ disk_name }} "{{ disk_path }}"
{% else %}
#define {{ disk_name }} basedisk "{{ disk_path }}"
{% endif %}
{% endfor %}

##################################################################################

TOPOLOGY_START({{ lab_name }}) 

{# This loop dynamically creates one bridge for each link in the YAML file #}
{% for link in links %}
bridge "111__{{ loop.index }}aaeppss"{};
{% endfor %}


{# This loop iterates over each VM defined in the YAML file #}
{% for vm in vms %}

{# --- CASE 1: Handle 'vmx' type (multi-FPC) --- #}
{% if vm.type == 'vmx' %}
#undef  VMX_CHASSIS_I2CID
#undef  VMX_CHASSIS_NAME
#define VMX_CHASSIS_I2CID   21
#define VMX_CHASSIS_NAME    {{ vm.hostname }}
VMX_CHASSIS_START()
    VMX_RE_START({{ vm.hostname }}_RE, 0)
        VMX_RE_INSTANCE({{ vm.hostname }}_RE, {{ vm.disk }}, VMX_RE_I2CID, 0)
        {# No baseline config is installed here any more. The vmx boots with
           only the lab's inherited groups (which provide netconf/ssh access),
           and vmm.py pushes the full baseline over SSH post-boot - see
           VMX_BASELINE_LINES / configure_vmx_ssh() in vmm.py. #}
        VMX_SYSTEST_CONFIG_ENHIP
    VMX_RE_END
    {# Only FPCs that have at least one interface used in 'links' get a block.
       Naming matches the existing "_RE"/"_FPC<n>" convention (same as
       vptx/vscapa) so get_vmx_nodes()'s "_RE" split and the "_FPC" serial
       filter in vmm.py work unmodified for multi-FPC vmx too. #}
    {% for group in vm.fpc_groups %}
    VMX_MPC_START({{ vm.hostname }}_FPC{{ group.fpc }}, {{ group.fpc }})
        #undef VMX_MPC_DISK
        #define VMX_MPC_DISK VIRTUAL_MPC_DISK
        VMX_MPC_INSTANCE({{ vm.hostname }}_FPC{{ group.fpc }}, VMX_MPC_DISK, {{ group.i2cid_macro }}, {{ group.fpc }})
        {% for iface in group.interfaces %}
        {% if iface.macro == 'GE' %}
        VMX_CONNECT(GE({{ iface.fpc }},{{ iface.pic }},{{ iface.port }}), {{ iface.bridge }})   // {{ iface.name }}
        {% elif iface.macro == 'XE' %}
        VMX_CONNECT(XE({{ iface.fpc }},{{ iface.pic }},{{ iface.port }}), {{ iface.bridge }})   // {{ iface.name }}
        {% elif iface.macro == 'XE_CHAN' %}
        VMX_CONNECT(XE_CHAN({{ iface.fpc }},{{ iface.pic }},{{ iface.port }},{{ iface.subport }}), {{ iface.bridge }})   // {{ iface.name }}
        {% endif %}
        {% endfor %}
    VMX_MPC_END
    {% endfor %}
VMX_CHASSIS_END



{# --- CASE 1b: Handle 'vferrari' type ---
   Reuses the standard VMX chassis/MPC macros, with a single FPC0 carrying
   5 fixed (non-channelized) 100G ports, et-0/0/0 .. et-0/0/4. Junos sees
   them as et-, but the VMM macro is ET(fpc,pic,port,subport) with the
   subport pinned to 0. #}
{% elif vm.type == 'vferrari' %}
#undef  VMX_CHASSIS_I2CID
#define VMX_CHASSIS_I2CID   33
#undef  VMX_MPC_MEMORY
#define VMX_MPC_MEMORY      8192
#undef  VMX_CHASSIS_NAME
#define VMX_CHASSIS_NAME    {{ vm.hostname }}
#undef  VMX_MPC_DISK
#define VMX_MPC_DISK        VMPC_LTS22_IMAGE
VMX_CHASSIS_START()
    VMX_RE_START({{ vm.hostname }}_RE, 0)
        VMX_RE_INSTANCE({{ vm.hostname }}_RE, {{ vm.disk }}, VMX_RE_I2CID, 0)
    VMX_RE_END

    VMX_MPC_START({{ vm.hostname }}_FPC0, 0)
        #undef VMX_MPC_MEMORY
        #define VMX_MPC_MEMORY 8192
        VMX_MPC_INSTANCE({{ vm.hostname }}_FPC0, VMX_MPC_DISK, VMX_ZT_MPC_I2CID, 0)
        {% for iface in vm.interfaces %}
        VMX_CONNECT(ET({{ iface.fpc }}, {{ iface.pic }}, {{ iface.port }}, {{ iface.subport }}), {{ iface.bridge }})   // {{ iface.name }}
        {% endfor %}
    VMX_MPC_END
VMX_CHASSIS_END



{# --- CASE 1c: Handle 'valfaromeo' type ---
   MX10008 chassis + VALFAROMEO FPC macros. FPC0 carries 4 ports x 4
   channelized subports, et-0/0/0:0 .. et-0/0/3:3, connected with
   IF_ET_CHAN(fpc,pic,port,subport). Management is on em0, not fxp0. #}
{% elif vm.type == 'valfaromeo' %}
#undef VPTX_CHASSIS_NAME
#define VPTX_CHASSIS_NAME {{ vm.hostname }}
VPTX_CHASSIS_START()
    VPTX_RE_START({{ vm.hostname }}_RE, 0)
        setvar "qemu_args" "-smbios type=1,product=PviModel,manufacturer=JUNIPER";
        VPTX_RE_INSTANCE({{ vm.hostname }}_RE, {{ vm.disk }}, VPTX_RE_I2CID, 0)
        setvar "smbios.system.maker" "JUNIPER";
        setvar "smbios.system.product" "RE-PTX-2X00x8";
        setvar "vm_retype" "RE-TVP";
        setvar "hgcomm_vector_idx" "5";
        install "/vmm/data/user_disks/dhahm/valfaromeo/default_tvp_platform_config_mx_tgz.img" "/tvp_platform_config.tgz";
        {# This system.config is the 12 x 100G_CHAN profile, which is what
           gives the channelized et-0/0/<port>:<subport> interfaces this type
           is validated against. dhahm's copy is the 4 x 100G (unchannelized)
           variant - swap it here if you want plain et-0/0/0..3 instead. #}
        install "/vmm/data/user_disks/valfaromeo/system.config" "/root/olive.conf";
        install "/vmm/data/user_disks/vredbull/conf/services" "/etc/services";
        install "/vmm/data/user_disks/vredbull/conf/inetd.conf" "/etc/inetd.conf";
        install "/vmm/data/user_disks/dhahm/valfaromeo/jlaunchd.conf" "/etc/jlaunchd.conf";
        install "/vmm/data/user_disks/dhahm/valfaromeo/pxe_slot_attrib.conf" "/usr/share/pfe/pxe_slot_attrib.conf";
    VPTX_RE_END

    #undef  FPC_BOOT_ARGS
    #define FPC_BOOT_ARGS   " " /* Unused; for future expansions. */
    // These come from i2cid_def_shared.h. Both AlfaRomeo linecards are the
    // same hardware type, so they share the I2C id; the slot is distinguished
    // by the VALFAROMEO_FPC<n> macro passed to the instance below.
    #undef  FPC_I2CID
    #define FPC_I2CID  0x0D7A /* I2C_ID_ALFAROMEO_LC */
    #undef  VPTX_FPC_CHASSIS_MODEL
    #define VPTX_FPC_CHASSIS_MODEL 263 /* JNX_PRODUCT_MODEL_MX10008 */

    {# One FPC block per FPC actually used in 'links'. Interfaces are grouped
       by their FPC number (et-<fpc>/0/<port>:<sub>), so a lab that only uses
       FPC0 renders exactly as before, and FPC1 gets its own block only when
       et-1/0/... interfaces are present. #}
    {% for fpc_num, fpc_ifaces in vm.interfaces | groupby('fpc') %}
    VALFAROMEO_FPC_START_ (VPTX_CHASSIS_NAME, VALFAROMEO_FPC{{ fpc_num }})

        setvar "qemu_args" "-drive file=/vmm/data/user_disks/vredbull/boot/vREDBULL_OVMF_CODE.fd,if=pflash,format=raw,unit=0,readonly=on -drive file=/vmm/data/user_disks/vredbull/boot/vREDBULL_OVMF_VARS.fd,if=pflash,format=raw,unit=1,readonly=on";

        VALFAROMEO_FPC_INSTANCE_DISKLESS (VPTX_CHASSIS_NAME, VPTX_FPC_CHASSIS_MODEL, VALFAROMEO_RE0, VALFAROMEO_FPC{{ fpc_num }}, FPC_I2CID, FPC_BOOT_ARGS)

        {% for iface in fpc_ifaces %}
        VALFAROMEO_CONNECT (IF_ET_CHAN ({{ iface.fpc }}, {{ iface.pic }}, {{ iface.port }}, {{ iface.subport }}),  {{ iface.bridge }})   // {{ iface.name }}
        {% endfor %}

    VALFAROMEO_FPC_END_
    {% endfor %}
VPTX_CHASSIS_END



{# --- CASE 2: Handle 'vptx' type --- #}
{% elif vm.type == 'vptx' %}
#undef VPTX_CHASSIS_I2CID
#define VPTX_CHASSIS_I2CID 85
#undef VPTX_CHASSIS_NAME
#define VPTX_CHASSIS_NAME {{ vm.hostname }}
#undef {{ vm.disk }}
{% for disk_name, disk_path in disks.items() %}
{% if disk_name.startswith('vptx') %}
#define {{ vm.disk }} basedisk "{{ disk_path }}";
{% endif %}
{% endfor %}
   VPTX_CHASSIS_START()
      VPTX_RE_START({{vm.hostname}}_RE, 0)
         VPTX_RE_INSTANCE({{vm.hostname}}_RE, {{vm.disk}}, VPTX_RE_I2CID, 0)
      VPTX_RE_END
      VPTX_MPC_START({{vm.hostname}}_FPC, 0)
          #undef VPTX_MPC_DISK
          #define VPTX_MPC_DISK VIRTUAL_MPC_DISK
         VPTX_MPC_INSTANCE({{vm.hostname}}_FPC, VPTX_MPC_DISK, VPTX_MPC_I2CID, 0)
          {% for iface in vm.interfaces %}
          VPTX_CONNECT(ET({{ iface.fpc }},{{ iface.pic }},{{ iface.port }},{{iface.subport}}),{{ iface.bridge }})
          {% endfor %}
      VPTX_MPC_END
   VPTX_CHASSIS_END




{# --- CASE 3: Handle 'vscapa' type --- #}
{% elif vm.type == 'vscapa' %}
#undef  PTX_CHAS_NAME
#define PTX_CHAS_NAME      {{ vm.hostname }}
#undef  PTX_CHAS_I2CID
#define PTX_CHAS_I2CID     240  /* JNX_PRODUCT_PTX10008 = 240 */
#define EVO_DEVELOPER_FILES \
        install "ENV(CONFIG_BASE)/evo-mount/yp.conf" "/etc/yp.conf";  \
        install "ENV(CONFIG_BASE)/evo-mount/auto.evo" "/etc/auto.evo"; \
        install "ENV(CONFIG_BASE)/evo-mount/auto.evofiler" "/etc/auto.evofiler"; \
        install "ENV(CONFIG_BASE)/evo-mount/auto.master" "/etc/auto.master";  \
        install "ENV(CONFIG_BASE)/evo-mount/nisdomainname" "/etc/nisdomainname";   \
        install "ENV(CONFIG_BASE)/evo-mount/nsswitch.conf" "/etc/nsswitch.conf";   \
        install "/vmm/data/vmm-configs/common/vptxc/rc.vmm" "/var/vmguest/rc.vmm";   \
        install "ENV(CONFIG_BASE)/evo-mount/ssh_host_rsa_key" "/home/root/.ssh/ssh_host_rsa_key"; \
        install "ENV(CONFIG_BASE)/evo-mount/ssh_host_rsa_key.pub" "/home/root/.ssh/ssh_host_rsa_key.pub";

EVOVPTX_CHASSIS_START_ (PTX_CHAS_NAME)
    EVOVPTX_RE_START_ (PTX_CHAS_NAME, EVOVPTX_RE0)
        #undef RE_BOOT_ARGS
        #define RE_BOOT_ARGS   " "
        #undef RE_I2CID
        #define RE_I2CID  0x0CA3
        EVOVPTX_RE0_INSTANCE_ISO_AUTODISK (PTX_CHAS_NAME, PTX_CHAS_I2CID, {{ vm.disk }}, EVOVPTX_RE0, RE_I2CID, RE_BOOT_ARGS)
        EVO_DEVELOPER_FILES
    EVOVPTX_RE_END_

    EVOVPTX_FPC_START_ (PTX_CHAS_NAME, EVOVPTX_FPC0)
        #undef FPC_BOOT_ARGS
        #define FPC_BOOT_ARGS   " "
        #undef FPC_I2CID
        #define FPC_I2CID  0x0D07
        EVOVPTX_FPC_INSTANCE_DISKLESS (PTX_CHAS_NAME, PTX_CHAS_I2CID, EVOVPTX_RE0, EVOVPTX_FPC0, FPC_I2CID, FPC_BOOT_ARGS)
    EVOVPTX_FPC_END_

    EVOVPTX_FPC_CSPP_START_ (PTX_CHAS_NAME, EVOVPTX_FPC0)
        EVOVPTX_FPC_CSPP_INSTANCE (PTX_CHAS_NAME, EVOVPTX_FPC0, EVOVPTX_FPC_CSPP_IMG)
        EVOVPTX_INSTALL_FPC_CSPP_BUNDLE_SCAPA (VMM_ENV_CSPP_CFG_DIR)
        {# This loop connects all the interfaces defined in the YAML file #}
        {% for iface in vm.interfaces %}
        EVOVPTX_CONNECT (IF_ET({{ iface.fpc }},{{ iface.pic }},{{ iface.port }}), {{ iface.bridge }})
        {% endfor %}
    EVOVPTX_FPC_CSPP_END_
EVOVPTX_CHASSIS_END_




{# --- CASE 3b: Handle 'vbrackla' type --- #}
{% elif vm.type == 'vbrackla' %}
#undef  PTX_CHAS_NAME
#define PTX_CHAS_NAME      {{ vm.hostname }}-vBrackla

EVOVPTX_CHASSIS_START_ (PTX_CHAS_NAME)
    EVOvBracklaRE(PTX_CHAS_NAME, {{ vm.disk }})
    EVOvBrackla_CSPP_START(PTX_CHAS_NAME, EVOVPTX_FPC_CSPP_IMG)
        {% for iface in vm.interfaces %}
        EVOVPTX_CONNECT(IF_ET({{ iface.fpc }},{{ iface.pic }},{{ iface.port }}), {{ iface.bridge }})
        {% endfor %}
    EVOvBrackla_CSPP_END
EVOVPTX_CHASSIS_END_




{# --- CASE 4: Handle 'vrouter' type --- #}
{% elif vm.type == 'vrouter' %}
#undef VJUNOS_CHASSIS_NAME
#define VJUNOS_CHASSIS_NAME   {{ vm.hostname }}
   VJUNOS_CHASSIS_START()
      VJUNOS_START({{ vm.hostname }} , 0)
         VJUNOS_INSTANCE({{ vm.hostname }} , {{ vm.disk }}, VJUNOS_PRODUCT_VMX, 0)
         {% for iface in vm.interfaces %}
         VJUNOS_CONNECT(VJUNOS_GE({{ iface.fpc }},{{ iface.pic }},{{ iface.port }}), {{ iface.bridge }})
        {% endfor %}
     VJUNOS_END
   VJUNOS_CHASSIS_END



{# --- CASE 5: Handle 'vswitch' type --- #}
{% elif vm.type == 'vswitch' %}
#undef VJUNOS_CHASSIS_NAME
#define VJUNOS_CHASSIS_NAME   {{ vm.hostname }}
   VJUNOS_CHASSIS_START()
      VJUNOS_START({{ vm.hostname }} , 0)
         VJUNOS_INSTANCE({{ vm.hostname }} , {{ vm.disk }}, VJUNOS_PRODUCT_VEX, 0)
         {% for iface in vm.interfaces %}
         VJUNOS_CONNECT(VJUNOS_GE({{ iface.fpc }},{{ iface.pic }},{{ iface.port }}), {{ iface.bridge }})
        {% endfor %}
     VJUNOS_END
   VJUNOS_CHASSIS_END




{# --- CASE 6: Handle 'server' type --- #}
{% elif vm.type == 'server' %}
vm "{{ vm.hostname }}" {
    hostname "{{ vm.hostname }}";
    {% if vm.disk is defined %}
    {{ vm.disk }};
    {% endif %}
    ncpus {{ vm.ncpus }};
    memory {{ vm.memory }};
    
    {# Servers get a dedicated management interface on em0 #}
    interface "em0" { bridge "external"; };
    {# This loop adds data interfaces (em1, em2, etc.) based on the 'links' data #}
    {% for iface in vm.interfaces %}
    interface "{{ iface.name }}" { bridge "{{ iface.bridge }}"; };
    {% endfor %}
};



{# --- CASE 7: Handle 'vqfx' type --- #}
{% elif vm.type == 'vqfx' %}
vm "{{ vm.hostname }}" {
    hostname "{{ vm.hostname }}";
    {% if vm.disk is defined %}
    {{ vm.disk }}
    {% endif %}
    setvar "boot_noveriexec" "YES";
    setvar "qemu_args" "-smbios type=1,product=QFX10K-11";
    install "/vmm/bin/configs/quincy/junos/vqfx.base.systest.conf" "/root/junos.base.conf";
    interface "em0" { EXTERNAL; };
    interface "em1" { bridge "pecosim_bridge_{{ vm.hostname }}"; ipaddr "169.254.0.2"; };
    interface "em2" { bridge "reserved_bridge"; };
    {% for iface in vm.interfaces %}
    interface "{{ iface.mapped_name }}" { bridge "{{ iface.bridge }}"; };
    {% endfor %}
};
vm "pecosim{{ vm.hostname }}_FPC" {
    hostname "pecosim{{ vm.hostname}}_FPC";
    COSIM_DISK
    memory 4096;
    ncpus 2;
    interface "em0" { EXTERNAL; };
    interface "em1" { bridge "pecosim_bridge_{{ vm.hostname }}"; ipaddr "169.254.0.1"; };
};



{#  Handle bridges --- #}
bridge "pecosim_bridge_{{ vm.hostname }}"{};
{% endif %}


{% endfor %}
{% if 'vqfx' in types %}
bridge "reserved_bridge"{};
{% endif %}



PRIVATE_BRIDGES
TOPOLOGY_END
